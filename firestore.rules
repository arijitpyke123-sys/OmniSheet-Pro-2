rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthenticated() {
      return request.auth != null;
    }

    function isUser(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isOwner(spreadsheetData) {
      return isAuthenticated() && spreadsheetData.ownerId == request.auth.uid;
    }

    function isCollaborator(spreadsheetData) {
      return isAuthenticated() && (
        spreadsheetData.ownerId == request.auth.uid ||
        (spreadsheetData.collaborators is list && request.auth.uid in spreadsheetData.collaborators) ||
        (spreadsheetData.collaborators is map && request.auth.uid in spreadsheetData.collaborators.keys())
      );
    }

    function getParentSpreadsheet(spreadsheetId) {
      return get(/databases/$(database)/documents/spreadsheets/$(spreadsheetId)).data;
    }

    function canReadParentSpreadsheet(spreadsheetId) {
      return isAuthenticated() && (
        getParentSpreadsheet(spreadsheetId).isPublic == true ||
        isCollaborator(getParentSpreadsheet(spreadsheetId))
      );
    }

    function canWriteParentSpreadsheet(spreadsheetId) {
      return isAuthenticated() && (
        getParentSpreadsheet(spreadsheetId).ownerId == request.auth.uid ||
        (getParentSpreadsheet(spreadsheetId).collaborators is map &&
         (getParentSpreadsheet(spreadsheetId).collaborators[request.auth.uid] == 'owner' ||
          getParentSpreadsheet(spreadsheetId).collaborators[request.auth.uid] == 'editor')) ||
        (getParentSpreadsheet(spreadsheetId).collaborators is list &&
         request.auth.uid in getParentSpreadsheet(spreadsheetId).collaborators)
      );
    }

    function isParentSpreadsheetOwner(spreadsheetId) {
      return isAuthenticated() && getParentSpreadsheet(spreadsheetId).ownerId == request.auth.uid;
    }

    // Registered users for collaborator discovery & profile
    match /users/{userId} {
      allow read: if isAuthenticated();
      allow write: if isUser(userId);
    }

    // Spreadsheets collection and all nested subcollections
    match /spreadsheets/{spreadsheetId} {
      // 1. Read: Must be authenticated and either owner, collaborator, or public
      allow read: if isAuthenticated() && (
        resource == null ||
        resource.data.isPublic == true ||
        isCollaborator(resource.data)
      );
      
      // 2. Create: Must set oneself as owner on creation AND spreadsheet document must not already exist
      // Prevents attempts to overwrite an existing spreadsheet ID!
      allow create: if isAuthenticated() && 
                    request.resource.data.ownerId == request.auth.uid &&
                    !exists(/databases/$(database)/documents/spreadsheets/$(spreadsheetId));
      
      // 3. Update: 
      // - Must be owner or editor collaborator
      // - Prevents an editor from promoting themselves to owner or changing the ownerId!
      allow update: if isAuthenticated() && (
        (isOwner(resource.data)) ||
        (isCollaborator(resource.data) && request.resource.data.ownerId == resource.data.ownerId)
      );
      
      // 4. Delete: Only owner can delete spreadsheet
      allow delete: if isAuthenticated() && isOwner(resource.data);

      // Direct Firestore access to nested Cell Data Subcollection
      // Prevents direct reads and writes against another user's spreadsheet!
      // Prevents a viewer from attempting to edit cells!
      match /data/{dataId} {
        allow read: if canReadParentSpreadsheet(spreadsheetId);
        allow write: if canWriteParentSpreadsheet(spreadsheetId);
      }

      // Collaborators Subcollection
      // Prevents a viewer or editor from changing collaborator roles or promoting to owner!
      match /collaborators/{collabId} {
        allow read: if canReadParentSpreadsheet(spreadsheetId);
        allow write: if isParentSpreadsheetOwner(spreadsheetId) && 
                     request.resource.data.role != 'owner';
      }

      // Audit Logs Subcollection (Append-only)
      match /auditLogs/{logId} {
        allow read: if canReadParentSpreadsheet(spreadsheetId);
        allow create: if canWriteParentSpreadsheet(spreadsheetId);
        allow update, delete: if false;
      }

      // All other nested subcollections
      match /{subcollection=**} {
        allow read: if canReadParentSpreadsheet(spreadsheetId);
        allow write: if canWriteParentSpreadsheet(spreadsheetId);
      }
    }

    // Tenant quotas and subscription plans (read-only for authenticated users)
    match /tenants/{tenantId} {
      allow read: if isAuthenticated();
      allow write: if false;

      match /{subcollection=**} {
        allow read: if isAuthenticated();
        allow write: if false;
      }
    }

    // Global default deny for everything else
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
